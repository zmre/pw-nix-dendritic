qwen4exp: keep MTP draft kpool inputs allocated (ggml-org/llama.cpp#30860)

With --spec-type draft-mtp the draft context's load-time probe decode builds
a graph that never reads k_idxs / new_pool_* , so gallocr gives them no
buffer, yet llm_graph_input_kpool::set_input still writes them and trips
GGML_ASSERT(buffer) in ggml-backend.cpp. Expanding them into the graph keeps
them allocated. Reporter's patch from issue #30860; PR #30592 carries the
same fix. Drop once nixpkgs' llama-cpp includes either.

--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -788,6 +788,7 @@ llama_model_qwen4exp::llm_graph_input_kpool * llama_model_qwen4exp::graph::build
     ggml_set_input(inp->tail_idxs);
 
     // set_input fills them all, so keep them allocated even when no op reads them
+    ggml_build_forward_expand(gf, inp->k_idxs);
     ggml_build_forward_expand(gf, inp->pool_cells);
     ggml_build_forward_expand(gf, inp->pool_idxs);
     ggml_build_forward_expand(gf, inp->pool_mask);
@@ -807,6 +808,10 @@ llama_model_qwen4exp::llm_graph_input_kpool * llama_model_qwen4exp::graph::build
     ggml_set_input(inp->new_pool_rep);
     inp->new_pool_pos = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, 4*inp->n_new);
     ggml_set_input(inp->new_pool_pos);
+    // set_input_kpool() fills these too; keep them allocated when the graph does not re-pool (MTP draft probe)
+    ggml_build_forward_expand(gf, inp->new_pool_idxs);
+    ggml_build_forward_expand(gf, inp->new_pool_rep);
+    ggml_build_forward_expand(gf, inp->new_pool_pos);
 
     return (llm_graph_input_kpool *) res->add_input(std::move(inp));
 }
